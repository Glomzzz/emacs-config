;;; tty-tests.el --- Terminal integration regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)

(defconst config-test/tty-startup-features
  (mapcar (lambda (feature) (cons feature (featurep feature)))
          '(xclip kitty-graphics xt-mouse tty-tip))
  "Terminal-only libraries loaded by an ordinary batch startup.")

(ert-deftest config-test/tty-integrations-stay-lazy ()
  (dolist (entry config-test/tty-startup-features)
    (should-not (cdr entry)))
  (should (memq #'tty/setup tty-setup-hook))
  (should (memq 'xclip packages/declared))
  (should (memq 'kitty-graphics packages/declared))
  (should (equal (plist-get (alist-get 'kitty-graphics packages/vc-sources)
                           :branch)
                 "v1.4.0"))
  (should-not (bound-and-true-p kitty-graphics-mode))
  (should-not (memq #'kitty-graphics-setup after-make-frame-functions)))

(ert-deftest config-test/tty-setup-leaves-gui-frames-alone ()
  (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
            ((symbol-function 'xterm-mouse-mode)
             (lambda (&rest _) (ert-fail "TTY mouse setup in a GUI")))
            ((symbol-function 'tty/enable-clipboard)
             (lambda () (ert-fail "TTY clipboard setup in a GUI"))))
    (tty/setup)))

(ert-deftest config-test/tty-setup-enables-instead-of-toggling ()
  (let (mouse tooltip)
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil))
              ((symbol-function 'xterm-mouse-mode)
               (lambda (arg) (push arg mouse)))
              ((symbol-function 'tty-tip-mode)
               (lambda (arg) (push arg tooltip)))
              ((symbol-function 'standard-display-unicode-special-glyphs) #'ignore)
              ((symbol-function 'tty/enable-clipboard) #'ignore))
      (tty/setup)
      (tty/setup)
      (should (equal mouse '(1 1)))
      (when (featurep 'tty-child-frames)
        (should (equal tooltip '(1 1)))))))

(ert-deftest config-test/tty-headless-keeps-terminal-clipboard ()
  (cl-letf (((symbol-function 'getenv) (lambda (&rest _) nil))
            ((symbol-function 'executable-find) (lambda (_) nil))
            ((symbol-function 'xclip-mode)
             (lambda (&rest _) (ert-fail "Clipboard tool enabled headlessly"))))
    (tty/enable-clipboard)))

(ert-deftest config-test/tty-clipboard-prefers-native-wayland ()
  (require 'xclip)
  (let ((xclip-method 'xclip)
        (xclip-program "xclip")
        enabled)
    (cl-letf (((symbol-function 'getenv) (lambda (&rest _) "present"))
              ((symbol-function 'executable-find)
               (lambda (name) (concat "/tools/" name)))
              ((symbol-function 'xclip-mode) (lambda (arg) (push arg enabled))))
      (tty/enable-clipboard)
      (tty/enable-clipboard)
      (should (eq xclip-method 'wl-copy))
      (should (equal xclip-program "/tools/wl-copy"))
      (should (equal enabled '(1 1))))))

(ert-deftest config-test/tty-clipboard-preserves-customized-backend ()
  (require 'xclip)
  (let ((xclip-method 'xsel)
        (xclip-program "/custom/xsel")
        (saved (get 'xclip-method 'saved-value)))
    (unwind-protect
        (progn
          (put 'xclip-method 'saved-value '((quote xsel)))
          (cl-letf (((symbol-function 'getenv) (lambda (&rest _) "present"))
                    ((symbol-function 'executable-find)
                     (lambda (name) (concat "/tools/" name)))
                    ((symbol-function 'xclip-mode) #'ignore))
            (tty/enable-clipboard)
            (should (eq xclip-method 'xsel))
            (should (equal xclip-program "/custom/xsel"))))
      (put 'xclip-method 'saved-value saved))))

;;; tty-tests.el ends here
