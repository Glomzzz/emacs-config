;;; modeline-tests.el --- Smart Mode Line integration regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'smart-mode-line)

(ert-deftest config-test/modeline-packages-theme-and-modern-minor-mode-slot ()
  (should (memq 'smart-mode-line packages/declared))
  (should (memq 'rich-minority packages/declared))
  (should modeline--configured)
  (should (eq sml/theme 'respectful))
  (should (memq 'gruber-darker custom-enabled-themes))
  (should-not sml/use-projectile-p)
  (should-not (bound-and-true-p rich-minority-mode))
  (should-not rm-blacklist)
  (should-not rm-whitelist)
  (when (boundp 'mode-line-minor-modes)
    (should (equal (default-value 'mode-line-minor-modes)
                   '(:eval (sml/generate-minor-modes))))))

(ert-deftest config-test/modeline-symbol-filter-keeps-dynamic-status-entries ()
  (let* ((status '((flymake-mode flymake-mode-line-format)
                   (envrc-mode envrc-lighter)
                   (overwrite-mode overwrite-mode)
                   (defining-kbd-macro mode-line-defining-kbd-macro)
                   (multiple-cursors-mode mc/mode-line)
                   (dired-async--modeline-mode (:eval "Running"))))
         (noise '((which-key-mode which-key-lighter)
                  (zoom-mode " Z")
                  (projectile-mode projectile--mode-line)
                  (undo-tree-mode undo-tree-mode-lighter)
                  (eldoc-mode eldoc-minor-mode-string)))
         (minor-mode-alist (append status noise))
         (original (copy-tree minor-mode-alist))
         result)
    (setq result
          (modeline/filter-minor-modes
           (lambda (argument)
             (should (eq argument 'unchanged))
             (copy-sequence minor-mode-alist))
           'unchanged))
    (should (equal result status))
    ;; Preserve actual lighter objects, not just their text, so properties
    ;; and dynamic diagnostics/cursor counts are still evaluated by SML.
    (should (eq (car result) (car status)))
    (should (equal minor-mode-alist original))))

(ert-deftest config-test/modeline-filter-preserves-native-status-properties ()
  (let* ((map (make-sparse-keymap))
         (status (propertize " envrc[error]"
                             'face 'error 'help-echo "Environment error"
                             'local-map map))
         (base-properties (copy-sequence rm-base-text-properties))
         (properties (copy-tree rm-text-properties))
         (rendered (modeline/filter-minor-modes
                    (lambda () (rm--propertize status)))))
    (should (eq (get-text-property 1 'face rendered) 'error))
    (should (equal (get-text-property 1 'help-echo rendered) "Environment error"))
    (should (eq (get-text-property 1 'local-map rendered) map))
    (should (equal rm-base-text-properties base-properties))
    (should (equal rm-text-properties properties))))

(ert-deftest config-test/modeline-filter-list-is-customizable ()
  (let ((modeline/visible-minor-modes '(projectile-mode))
        (minor-mode-alist '((envrc-mode envrc-lighter)
                            (projectile-mode projectile--mode-line))))
    (should (equal (modeline/filter-minor-modes
                    (lambda () minor-mode-alist))
                   '((projectile-mode projectile--mode-line))))))

(ert-deftest config-test/modeline-filter-preserves-error-and-match-data ()
  (let* ((minor-mode-alist '((zoom-mode " Z") (flymake-mode "Flymake")))
         (original minor-mode-alist))
    (should-error
     (modeline/filter-minor-modes (lambda () (error "Rendering failure"))))
    (should (eq original minor-mode-alist))
    (string-match "match" "keep match data")
    (let ((before (match-data)))
      (modeline/filter-minor-modes (lambda () nil))
      (should (equal (match-data) before)))))

(ert-deftest config-test/modeline-setup-is-idempotent ()
  (let ((mode-line (copy-tree (default-value 'mode-line-format)))
        (properties (copy-sequence rm-base-text-properties))
        (hooks (copy-sequence after-save-hook)))
    (modeline/setup)
    (modeline/setup)
    (should (equal mode-line (default-value 'mode-line-format)))
    (should (equal properties rm-base-text-properties))
    (should (equal hooks after-save-hook))
    (let ((count 0))
      (advice-mapc (lambda (function _properties)
                     (when (eq function #'modeline/filter-minor-modes)
                       (setq count (1+ count))))
                   'sml/generate-minor-modes)
      (should (= count 1)))))

(ert-deftest config-test/modeline-keeps-major-mode-narrowing-and-server-status ()
  (should (memq 'mode-line-modes (default-value 'mode-line-format)))
  (should (memq 'mode-line-misc-info (default-value 'mode-line-format)))
  (should (memq 'mode-line-modified (default-value 'mode-line-format)))
  (should (memq 'mode-line-remote (default-value 'mode-line-format)))
  (should (cl-find-if (lambda (item)
                        (and (stringp item) (string-match-p "%n" item)))
                      mode-line-modes))
  (should (assq 'eglot--managed-mode mode-line-misc-info))
  (should (assq 'flymake-mode minor-mode-alist))
  (should (memq 'overwrite-mode modeline/visible-minor-modes))
  (should (memq 'multiple-cursors-mode modeline/visible-minor-modes)))

(ert-deftest config-test/modeline-hidden-modes-and-keymaps-still-work ()
  (should which-key-mode)
  (should zoom-mode)
  (should projectile-mode)
  (should (bound-and-true-p global-undo-tree-mode))
  (should (eq (key-binding (kbd "C-c P f")) #'counsel-projectile-find-file))
  (should (eq (key-binding (kbd "C-x C-h w")) #'hydra-window/body))
  (dolist (mode '(which-key-mode zoom-mode projectile-mode undo-tree-mode))
    (should (assq mode minor-mode-alist))
    (should-not (memq mode modeline/visible-minor-modes))))

(provide 'modeline-tests)
;;; modeline-tests.el ends here
