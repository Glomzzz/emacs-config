;;; workspaces-tests.el --- Tabspaces integration regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(defconst config-test/tabspaces-loaded-on-startup (featurep 'tabspaces)
  "Whether module loading eagerly loaded Tabspaces and its Dired dependencies.")
(workspaces/enable)
(require 'consult)

(defmacro config-test/with-workspaces (&rest body)
  "Run BODY with isolated tabs, preserving the frame's original state."
  (declare (indent 0) (debug t))
  `(save-window-excursion
     (let ((original-tabs (frame-parameter nil 'tabs))
           (original-buffers (frame-parameter nil 'buffer-list))
           (original-buried (frame-parameter nil 'buried-buffer-list))
           (tabspaces-project-tab-map nil)
           (tabspaces--session-list nil)
           (project--list nil))
       (unwind-protect
           (progn
             (set-frame-parameter nil 'tabs nil)
             (delete-other-windows)
             (switch-to-buffer (get-buffer-create "*scratch*"))
             (tab-bar-rename-tab "Default")
             (tabspaces-reset-buffer-list)
             ,@body)
         (set-frame-parameter nil 'tabs original-tabs)
         (set-frame-parameter nil 'buffer-list original-buffers)
         (set-frame-parameter nil 'buried-buffer-list original-buried)))))

(defun config-test/workspace-candidate-names (source)
  "Return candidate names from Consult SOURCE, ignoring metadata."
  (mapcar (lambda (candidate)
            (substring-no-properties
             (if (consp candidate) (car candidate) candidate)))
          (funcall (plist-get (symbol-value source) :items))))

(ert-deftest config-test/workspaces-package-prefix-and-existing-bindings ()
  (should (memq 'tabspaces packages/declared))
  (should-not config-test/tabspaces-loaded-on-startup)
  (should (memq #'workspaces/enable emacs-startup-hook))
  (should tabspaces-mode)
  (should tab-bar-mode)
  (should-not tab-bar-show)
  (should tabspaces-session)
  (should tabspaces-session-auto-restore)
  (should-not tabspaces-initialize-project-with-todo)
  (should-not tabspaces-use-filtered-buffers-as-default)
  (should-not tabspaces-project-fallback-to-tab)
  (should-not tabspaces-project-switch-opens-workspace)
  (dolist (entry '(("C-c w s" . tabspaces-switch-or-create-workspace)
                   ("C-c w o" . tabspaces-open-or-create-project-and-workspace)
                   ("C-c w r" . tabspaces-remove-current-buffer)
                   ("C-c w S" . tabspaces-save-session)
                   ("C-c w L" . tabspaces-restore-session)
                   ("C-c w ." . hydra-workspaces/body)
                   ("C-x C-h W" . hydra-workspaces/body)
                   ("C-x C-h w" . hydra-window/body)
                   ("C-x b" . consult-buffer)
                   ("C-x p b" . consult-project-buffer)
                   ("C-c P f" . counsel-projectile-find-file)))
    (should (eq (key-binding (kbd (car entry))) (cdr entry)))))

(ert-deftest config-test/workspaces-consult-source-only-filters-workspace-buffers ()
  (config-test/with-workspaces
    (let ((first (generate-new-buffer "*config-tabspaces-first*"))
          (second (generate-new-buffer "*config-tabspaces-second*")))
      (unwind-protect
          (progn
            (switch-to-buffer first)
            (tabspaces-switch-or-create-workspace "Second")
            (switch-to-buffer second)
            (should (memq second (tabspaces-local-buffer-list)))
            (should-not (memq first (tabspaces-local-buffer-list)))
            (let ((local (config-test/workspace-candidate-names
                          'workspaces/consult-source-buffer))
                  (global (config-test/workspace-candidate-names
                           'workspaces/consult-source-all-buffers)))
              (should (member (buffer-name second) local))
              (should-not (member (buffer-name first) local))
              (should (member (buffer-name first) global))
              (should (member (buffer-name second) global)))
            ;; Source-local filtering must not affect project commands,
            ;; multi-buffer search, or recent-file deduplication.
            (should (eq consult-buffer-list-function #'buffer-list))
            (should (= (plist-get workspaces/consult-source-buffer :narrow) ?w))
            (should (= (plist-get workspaces/consult-source-all-buffers :narrow) ?b))
            (should (plist-get workspaces/consult-source-all-buffers :hidden))
            (should-not (plist-get consult-source-buffer :hidden))
            (bury-buffer second)
            (should (memq second (tabspaces-local-buffer-list)))
            (switch-to-buffer second)
            (tabspaces-remove-buffer first)
            (tabspaces-remove-current-buffer)
            (should-not (memq second (tabspaces-local-buffer-list)))
            (should (buffer-live-p second)))
        (kill-buffer first)
        (kill-buffer second)))))

(ert-deftest config-test/workspaces-consult-mode-toggle-is-idempotent ()
  (let ((sources (copy-sequence consult-buffer-sources))
        (original (copy-sequence consult-source-buffer)))
    (unwind-protect
        (progn
          (tabspaces-mode -1)
          (should (memq 'consult-source-buffer consult-buffer-sources))
          (should-not (memq 'workspaces/consult-source-buffer consult-buffer-sources))
          (workspaces/enable)
          (workspaces/enable)
          (should (= 1 (cl-count 'workspaces/consult-source-buffer consult-buffer-sources)))
          (should (= 1 (cl-count 'workspaces/consult-source-all-buffers consult-buffer-sources)))
          (should-not (memq 'consult-source-buffer consult-buffer-sources))
          (should (equal consult-source-buffer original))
          (should (equal consult-buffer-sources sources)))
      (workspaces/enable))))

(ert-deftest config-test/workspaces-state-paths-and-project-name-collisions ()
  (let ((prefix (file-name-as-directory (expand-file-name cache/root))))
    (should (string-prefix-p prefix tabspaces-session-file))
    (should (string-prefix-p prefix workspaces/project-session-directory)))
  (should (eq tabspaces-session-project-session-store
              #'workspaces/project-session-file))
  (let ((first (workspaces/project-session-file "/tmp/one/project/"))
        (second (workspaces/project-session-file "/tmp/two/project/")))
    (should-not (equal first second))
    (should (equal first (workspaces/project-session-file "/tmp/one/project")))
    (should (string-prefix-p workspaces/project-session-directory first))))

(ert-deftest config-test/workspaces-enable-keeps-batch-runs-offline-and-session-free ()
  (let (enabled)
    (cl-letf (((symbol-function 'tab-bar-mode) #'ignore)
              ((symbol-function 'tabspaces-mode)
               (lambda (arg)
                 (should (= arg 1))
                 (should-not tabspaces-session-auto-restore)
                 (setq enabled t))))
      (let ((noninteractive t))
        (workspaces/enable)))
    (should enabled)
    (should tabspaces-session-auto-restore)
    (should-not (memq #'tabspaces--save-session-smart kill-emacs-hook))
    (should-not (memq #'workspaces/save-session kill-emacs-hook))))

(ert-deftest config-test/workspaces-interactive-enable-keeps-automatic-restoration ()
  (let (enabled)
    (cl-letf (((symbol-function 'tab-bar-mode) #'ignore)
              ((symbol-function 'tabspaces-mode)
               (lambda (arg)
                 (should (= arg 1))
                 (should tabspaces-session-auto-restore)
                 (setq enabled t))))
      (let ((noninteractive nil))
        (workspaces/enable)))
    (should enabled)))

(ert-deftest config-test/workspaces-daemon-restoration-waits-for-first-client ()
  (let* ((directory (make-temp-file "tabspaces-startup-" t))
         (tabspaces-session-file (expand-file-name "session.el" directory))
         (server-after-make-frame-hook nil)
         (kill-emacs-hook nil)
         restored)
    (unwind-protect
        (cl-letf (((symbol-function 'daemonp) (lambda () t))
                  ((symbol-function 'tabspaces-restore-session)
                   (lambda (&optional _file) (setq restored t))))
          (let ((noninteractive nil))
            (workspaces/enable)
            (should-not restored)
            (should (memq #'tabspaces--deferred-startup-restore
                          server-after-make-frame-hook))
            (should (memq #'tabspaces--save-session-smart kill-emacs-hook))
            (run-hooks 'server-after-make-frame-hook)
            (should restored)
            (should-not (memq #'tabspaces--deferred-startup-restore
                              server-after-make-frame-hook))))
      (delete-directory directory t))))

(ert-deftest config-test/workspaces-exit-saves-complete-snapshot-after-projects ()
  (let ((kill-emacs-hook (list #'tabspaces--save-session-smart))
        (tabspaces-mode t)
        (tabspaces-session t)
        calls)
    (cl-letf (((symbol-function 'tabspaces--save-session-smart)
               (lambda () (push 'projects calls)))
              ((symbol-function 'tabspaces-save-session)
               (lambda () (push 'complete calls))))
      (let ((noninteractive nil))
        (workspaces/configure-session-save)
        (run-hooks 'kill-emacs-hook)
        (should (equal (nreverse calls) '(projects complete)))
        (let ((tabspaces-mode nil))
          (workspaces/configure-session-save)
          (should-not (memq #'workspaces/save-session kill-emacs-hook))))
      (setq calls nil)
      (let ((noninteractive t))
        (workspaces/save-session))
      (should-not calls))))

(ert-deftest config-test/workspaces-project-creation-preserves-marker-roots ()
  (config-test/with-directory
    (config-test/file root "package.json" "{}")
    (config-test/file root "nested/hie.yaml" "cradle: {}")
    (make-directory (expand-file-name "nested/src/" root))
    (config-test/with-workspaces
      (let ((project-root (expand-file-name "nested/" root))
            (tabspaces-project-switch-commands #'ignore))
        (tabspaces-open-or-create-project-and-workspace project-root)
        (should (equal (project-root (project-current nil
                                      (expand-file-name "nested/src/" root)))
                       project-root))
        (should-not (memq #'project-projectile project-find-functions))
        (should-not (file-exists-p (expand-file-name "project-todo.org" project-root)))
        (should-not (file-exists-p (expand-file-name ".git" project-root)))
        (should (equal (cdr (assoc project-root tabspaces-project-tab-map))
                       (alist-get 'name (tab-bar--current-tab)))))
      (should-not (project-current nil temporary-file-directory)))))

(ert-deftest config-test/workspaces-session-round-trip-restores-files-and-layout ()
  (config-test/with-directory
    (config-test/with-workspaces
      (let* ((first-file (config-test/file root "first.txt" "First\n"))
             (second-file (config-test/file root "second.txt" "Second\n"))
             (tabspaces-session-file (expand-file-name "session.el" root))
             first second)
        (unwind-protect
            (progn
              (setq first (find-file-noselect first-file)
                    second (find-file-noselect second-file))
              (tabspaces-switch-or-create-workspace "Saved")
              (switch-to-buffer first)
              (set-window-buffer (split-window-right) second)
              (tabspaces-save-session)
              (should (file-exists-p tabspaces-session-file))
              (tabspaces-close-workspace)
              (kill-buffer first)
              (kill-buffer second)
              (tabspaces-restore-session tabspaces-session-file)
              (tab-bar-select-tab-by-name "Saved")
              (should (= (length (window-list)) 2))
              (should (get-file-buffer first-file))
              (should (get-file-buffer second-file))
              (should (memq (get-file-buffer first-file) (tabspaces-local-buffer-list)))
              (should (memq (get-file-buffer second-file) (tabspaces-local-buffer-list)))
              (should-not (get-buffer "*tabspaces--placeholder*")))
          (dolist (file (list first-file second-file))
            (when-let* ((buffer (get-file-buffer file)))
              (kill-buffer buffer))))))))

(ert-deftest config-test/workspaces-project-session-saves-in-cache-not-project ()
  (config-test/with-directory
    (config-test/file root "package.json" "{}")
    (config-test/with-workspaces
      (let* ((tabspaces-project-switch-commands #'ignore)
             (session (workspaces/project-session-file root)))
        (unwind-protect
            (progn
              (tabspaces-open-or-create-project-and-workspace root)
              (let ((default-directory root))
                (tabspaces-save-current-project-session))
              (should (file-exists-p session))
              (should (equal (directory-files root nil "^[^.]") '("package.json"))))
          (when (file-exists-p session) (delete-file session)))))))

(ert-deftest config-test/workspaces-hydra-dispatches-and-exits ()
  (dolist (entry '(("s" . tabspaces-switch-or-create-workspace)
                   ("o" . tabspaces-open-or-create-project-and-workspace)
                   ("b" . consult-buffer)
                   ("S" . tabspaces-save-session)
                   ("L" . tabspaces-restore-session)))
    (let (called)
      (cl-letf (((symbol-function (cdr entry))
                 (lambda ()
                   (interactive)
                   (should-not hydra-curr-map)
                   (setq called t))))
        (unwind-protect
            (progn
              (execute-kbd-macro (vconcat (kbd "C-x C-h W") (kbd (car entry))))
              (should called)
              (should-not hydra-curr-map))
          (hydra-keyboard-quit))))))

(provide 'workspaces-tests)
;;; workspaces-tests.el ends here
