;;; packages-tests.el --- Package bootstrap contract -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'package-vc)

(ert-deftest config-test/packages-vc-declaration-is-offline ()
  (let ((packages/declared nil)
        (packages/vc-sources nil)
        (packages/bootstrap-mode nil)
        (source '(:url "https://example.invalid/package" :vc-backend Git)))
    (cl-letf (((symbol-function 'package-vc-install)
               (lambda (&rest _) (ert-fail "Startup attempted a VC install")))
              ((symbol-function 'package-install)
               (lambda (&rest _) (ert-fail "Startup attempted an archive install")))
              ((symbol-function 'package-refresh-contents)
               (lambda (&rest _) (ert-fail "Startup attempted an archive refresh"))))
      (packages/declare-vc 'test-source source)
      (packages/declare-vc 'test-source source)
      (should (equal packages/declared '(test-source)))
      (should (equal packages/vc-sources `((test-source . ,source)))))))

(ert-deftest config-test/packages-bootstrap-installs-vc-source-once ()
  (let ((packages/declared nil)
        (packages/vc-sources nil)
        (packages/bootstrap-mode t)
        (packages--installed-count 0)
        (source '(:url "https://example.invalid/package" :vc-backend Git))
        installed calls)
    (cl-letf (((symbol-function 'package-installed-p)
               (lambda (_package) installed))
              ((symbol-function 'package-vc-install)
               (lambda (spec)
                 (push spec calls)
                 (setq installed t)))
              ((symbol-function 'package-install)
               (lambda (&rest _) (ert-fail "VC source used archive installation")))
              ((symbol-function 'package-refresh-contents)
               (lambda (&rest _) (ert-fail "VC source refreshed archive metadata"))))
      (packages/declare-vc 'test-source source)
      (packages/declare-vc 'test-source source)
      (should (equal calls `((test-source . ,source))))
      (should (= packages--installed-count 1)))))

(ert-deftest config-test/packages-interactive-bootstrap-dispatches-vc-and-archives ()
  (let ((packages/declared '(test-source test-archive))
        (packages/vc-sources '((test-source :url "https://example.invalid/package")))
        (package-archive-contents '((test-archive . ignored)))
        (packages--installed-count 0)
        (packages--archives-refreshed nil)
        installed saved)
    (cl-letf (((symbol-function 'package-installed-p)
               (lambda (package) (memq package installed)))
              ((symbol-function 'package-vc-install)
               (lambda (spec) (push (car spec) installed)))
              ((symbol-function 'package-install)
               (lambda (package dont-select)
                 (should (eq dont-select 'dont-select))
                 (push package installed)))
              ((symbol-function 'packages/save-selection)
               (lambda () (setq saved t))))
      (packages/bootstrap)
      (should (equal installed '(test-archive test-source)))
      (should saved))))

(provide 'packages-tests)
;;; packages-tests.el ends here
