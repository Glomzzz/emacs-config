;;; mail-tests.el --- Offline mail configuration regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)

(defconst config-test/mu4e-loaded-on-startup (featurep 'mu4e))
(defconst config-test/mail-async-loaded-on-startup (featurep 'mail-async))
(defconst config-test/mu4e-user-agent-autoload-on-startup
  (autoloadp (symbol-function 'mu4e-user-agent)))

(ert-deftest config-test/mail-startup-stays-lazy-and-nix-managed ()
  (should-not config-test/mu4e-loaded-on-startup)
  (should-not config-test/mail-async-loaded-on-startup)
  (should-not (memq 'mu4e packages/declared))
  (should (eq (key-binding (kbd "C-c M")) #'mu4e))
  (should (eq (key-binding (kbd "C-c m")) #'consult-man))
  (should config-test/mu4e-user-agent-autoload-on-startup))

(ert-deftest config-test/mail-special-folders-reject-unverified-or-missing-paths ()
  (dolist (value '(nil "" "/Sent" "/infomaniak/../Sent" "/infomaniak/Missing"))
    (let ((mail/special-folders `((sent . ,value))))
      (should-error (mail/folder 'sent) :type 'user-error)))
  (let ((mail/special-folders nil))
    (dolist (kind '(sent drafts trash archive))
      (should-error (mail/folder kind) :type 'user-error))))

(ert-deftest config-test/mail-special-folders-require-all-maildir-subdirectories ()
  (let ((mail/special-folders '((sent . "/infomaniak/Sent Items"))))
    (cl-letf (((symbol-function 'file-directory-p)
               (lambda (path) (not (string-suffix-p "/tmp" path)))))
      (should-error (mail/folder 'sent) :type 'user-error))
    (cl-letf (((symbol-function 'file-directory-p) (lambda (_path) t)))
      (should (equal (mail/folder 'sent nil) "/infomaniak/Sent Items")))))

(ert-deftest config-test/mail-mu4e-uses-external-sync-and-keeps-sent-mail ()
  ;; Only load Lisp, never start mu's server or retrieve/send real messages.
  (skip-unless (locate-library "mu4e"))
  (require 'mu4e)
  (should (equal user-mail-address "me@glomzzz.com"))
  (should (equal user-full-name "Glom Zhao"))
  (should (equal mu4e-get-mail-command "true"))
  (should (= mu4e-update-interval 300))
  (should mu4e-change-filenames-when-moving)
  (should (eq mu4e-sent-messages-behavior 'sent))
  (should (eq message-send-mail-function #'message-send-mail-with-sendmail))
  (should (memq #'mail-async/mode mu4e-compose-mode-hook))
  (should (equal message-sendmail-extra-arguments '("--read-envelope-from")))
  (should message-sendmail-f-is-evil)
  (should (equal (file-name-nondirectory sendmail-program) "msmtp"))
  (let ((mail/special-folders nil))
    (dolist (getter '(mu4e-get-sent-folder mu4e-get-drafts-folder
                     mu4e-get-trash-folder mu4e-get-refile-folder))
      (should-error (funcall getter) :type 'user-error))))

(ert-deftest config-test/mail-folder-picker-does-not-save-on-cancellation ()
  (skip-unless (locate-library "mu4e"))
  (require 'mu4e)
  (let ((mail/special-folders nil)
        saved)
    (cl-letf (((symbol-function 'mu4e-get-maildirs)
               (lambda () '("/infomaniak/Sent" "/other/Sent")))
              ((symbol-function 'completing-read)
               (lambda (_prompt candidates &rest _)
                 (should (equal candidates '("/infomaniak/Sent")))
                 (car candidates)))
              ((symbol-function 'yes-or-no-p) (lambda (_) nil))
              ((symbol-function 'customize-save-variable)
               (lambda (&rest _) (setq saved t))))
      (mail/configure-folders)
      (should-not saved)
      (should-not mail/special-folders))))

(ert-deftest config-test/mail-folder-picker-saves-all-verified-roles ()
  (skip-unless (locate-library "mu4e"))
  (require 'mu4e)
  (let ((mail/special-folders nil)
        (folders '("/infomaniak/Sent" "/infomaniak/Drafts"
                   "/infomaniak/Trash" "/infomaniak/Archive"))
        saved)
    (cl-letf (((symbol-function 'mu4e-get-maildirs) (lambda () folders))
              ((symbol-function 'completing-read)
               (lambda (&rest _) (pop folders)))
              ((symbol-function 'yes-or-no-p) (lambda (_) t))
              ((symbol-function 'customize-save-variable)
               (lambda (variable value)
                 (should (eq variable 'mail/special-folders))
                 (setq saved value))))
      (mail/configure-folders)
      (should (equal saved '((sent . "/infomaniak/Sent")
                            (drafts . "/infomaniak/Drafts")
                            (trash . "/infomaniak/Trash")
                            (archive . "/infomaniak/Archive")))))))

(provide 'mail-tests)
;;; mail-tests.el ends here
